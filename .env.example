# Postgres connection string (Neon or Vercel Postgres, free tier).
# Use the *pooled* connection string on Vercel. POSTGRES_URL is read as a
# fallback, which is the name Vercel's own Postgres integrations inject.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Local dev example (no SSL):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/iago_radar"

# Shared secret for /api/cron/crawl. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Public base URL, used by the crawler to chain its own follow-up invocations.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically.
# APP_BASE_URL="https://iago-radar.vercel.app"

# Contact string appended to the User-Agent sent to Nominatim and Overpass.
# Both APIs ask for a way to reach you if a query misbehaves. Please set this.
OSM_CONTACT="you@example.com"
